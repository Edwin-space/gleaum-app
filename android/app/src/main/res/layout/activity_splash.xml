<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/startup_background"
    android:clipChildren="false">

    <View
        android:id="@+id/glowBlue"
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-160dp"
        android:layout_marginEnd="-180dp"
        android:alpha="0"
        android:background="@drawable/startup_glow_blue" />

    <View
        android:id="@+id/glowTeal"
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/startup_glow_teal" />

    <LinearLayout
        android:id="@+id/brandGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:contentDescription="@string/brand_logo_description"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_icon" />

        <TextView
            android:id="@+id/brandWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:text="@string/brand_wordmark"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/brandTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="@string/brand_tagline_ko"
            android:textColor="#B8FFFFFF"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/startupStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/startupProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="#0CC9B5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/startup_connecting"
            android:textColor="#8FFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
